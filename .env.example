# Railway backend (server binary)
# Postgres connection string. On Railway set it to ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://postgres:password@localhost:5432/shorturl
# Public address shown in generated short URLs (the Cloudflare Worker URL in production).
PUBLIC_BASE_URL=http://localhost:8080
# Bind address. Railway injects PORT automatically.
IP=0.0.0.0
PORT=8080

# Cloudflare Worker (cloudflare/wrangler.jsonc → vars)
# BACKEND_URL=https://<your-service>.up.railway.app
